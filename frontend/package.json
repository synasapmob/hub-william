{
  "name": "@hub-william/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:generate": "cargo run --quiet --manifest-path ../backend/Cargo.toml --bin export_openapi -- ../backend/openapi.json && openapi-typescript ../backend/openapi.json -o src/services/api.generated.ts && prettier --write src/services/api.generated.ts ../backend/openapi.json",
    "dev": "react-router dev",
    "build": "react-router typegen && tsc -b && react-router build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint && eslint . --max-warnings 0",
    "check:tailwind": "node scripts/tailwind/check-tailwind-canonical.mjs src",
    "preview": "vite preview --outDir build/client",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-router/node": "^8.3.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "lucide-react": "^1.28.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router": "^8.3.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.3.0",
    "@react-router/fs-routes": "^8.3.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fflate": "^0.8.3",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.56.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
