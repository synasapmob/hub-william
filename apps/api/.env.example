PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hub_william
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Rate limiting keys on the client IP. Behind a proxy that overwrites CLIENT_IP_HEADER
# (verify this on the deployed environment first), set TRUST_PROXY_HEADERS=true.
# Left off, every client behind that proxy shares the proxy's address and one bucket.
# TRUST_PROXY_HEADERS=false
# CLIENT_IP_HEADER=x-real-ip

PROVIDER_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64url-encoded-32-byte-key

# Optional. Encrypts the accounts (one email|password each) a Telegram package hands to
# a buyer. Use a different key from the one above, and a different one in each environment.
# Unset, the service runs and simply cannot load accounts. A key that is set but is not
# 32 bytes of unpadded base64url stops the service at start. Make one with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# STOCK_ENCRYPTION_KEY=replace-with-base64url-encoded-32-byte-key

# Optional provider-contract override for local integration tests.
# CLAUDE_PROFILE_URL=https://api.anthropic.com/api/oauth/profile

# Required for Gemini subscription OAuth. Keep the AGY client credential in the runtime secret store.
GEMINI_OAUTH_CLIENT_SECRET=replace-with-the-agy-oauth-client-secret

# Optional local/mock override. Production uses DeepSeek's official API by default.
# DEEPSEEK_API_URL=https://api.deepseek.com

# Optional local/mock overrides for the model lists behind the ChatGPT and Claude gateway keys.
# CHATGPT_CODEX_MODELS_URL=https://chatgpt.com/backend-api/codex/models
# CLAUDE_MODELS_URL=https://api.anthropic.com/v1/models?limit=1000

# Keys for the callers of this API, as name:key pairs separated by commas. The name decides
# what the key may do (apps/api/src/api/access/mod.rs); a name with no line there may do
# nothing. A key is at least 32 visible characters. Make one with:  openssl rand -hex 32
# `telegram` is the bot, with the same value as the bot's TELEGRAM_SERVICE_TOKEN. Shops call
# GET /partner/products with Authorization: Bearer <key>. Remove an entry to revoke it.
# SHOP_KEYS=telegram:replace-with-a-long-random-key,shopwatcher.org:replace-with-another-long-random-key

# Where this API reaches apps/telegram, so the dashboard can have the bot send a
# message or tell a buyer their order is paid. Needs the telegram key above to
# equal the adapter's TELEGRAM_SERVICE_TOKEN. Unset, the dashboard says it is not connected.
# TELEGRAM_ADAPTER_URL=http://localhost:8090

# Lets a service wallet be topped up without a payment. Staging only.
# SERVICE_TEST_TOP_UP=true

# Paying the service wallet in by card with Stripe. Use the test-mode keys while
# building: sk_test_... from Developers > API keys, and the signing secret whsec_...
# of the webhook endpoint (POST /stripe/webhook) or the one `stripe listen` prints.
# Set both or neither; unset, a top-up falls back to SERVICE_TEST_TOP_UP or answers 501.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional local/mock override of Stripe's API, for tests against a fake.
# STRIPE_API_URL=https://api.stripe.com
