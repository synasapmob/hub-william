# Copied to ~/.zsh/secrets.zsh on the first install, then never touched again.
#
# secrets.zsh is yours and gitignored; this .example is committed. Keep real
# values out of this file. The fragments next to it read these variables at
# call time, so a blank value degrades one command, it does not break your
# shell.

# Hub William gateway and telemetry key (hw_sk_...).
export HUB_WILLIAM_KEY=""

# Supabase needs nothing here any more. It used to take a personal access
# token per project account, read by the `sb-*` wrappers; both the wrappers and
# the tokens are gone, and each project is reached through its own MCP server
# instead. If you still have those PATs, revoke them — an unused credential is
# not a harmless one.
#
# Linear, Notion, Supabase and Slack all authenticate the same way: they are
# HTTP MCP servers that log in through a browser — `hub-william mcp auth` —
# and each harness keeps its own token. There is no API key to set here and no
# shared login across the three.
