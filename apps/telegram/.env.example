PORT=8090
# The current Railway private API hostname. Local development may use http://localhost:8080.
HUB_API_INTERNAL_URL=http://backend.railway.internal:8080
# Must exactly match TELEGRAM_SERVICE_TOKEN on apps/api.
HUB_API_SERVICE_TOKEN=replace-with-the-shared-api-service-token
# 1-256 characters: A-Z, a-z, 0-9, _, and - only.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# BotFather token. The running adapter uses it to acknowledge inline-button
# callbacks; scripts/configure-webhook.sh also uses it to register the webhook.
# Never place it in frontend or API variables.
TELEGRAM_BOT_TOKEN=replace-with-the-botfather-token
# Optional local test override. Railway uses Telegram's official API by default.
# TELEGRAM_API_BASE_URL=https://api.telegram.org/
# Railway's public URL for this service. scripts/configure-webhook.sh appends /webhook.
TELEGRAM_WEBHOOK_URL=https://telegram-production-example.up.railway.app
# Optional override for this service's own public origin. Telegram fetches the
# payment QR from it. Defaults to TELEGRAM_WEBHOOK_URL.
# TELEGRAM_PUBLIC_URL=https://telegram-production-example.up.railway.app
# The API key SePay sends as `Authorization: Apikey …` on its bank-transaction
# webhook. Without it the /sepay route refuses every call.
SEPAY_API_KEY=replace-with-the-sepay-webhook-api-key
# Who may use the owner side of /catalog. Usernames are comma-separated and
# default to synasapmob. A Telegram username can be released and taken by
# somebody else, so set TELEGRAM_OWNER_IDS to your numeric Telegram id as well:
# an id cannot be reassigned, and either list grants access.
# TELEGRAM_OWNER_USERNAMES=synasapmob
# TELEGRAM_OWNER_IDS=123456789
# Where a restock is announced: a channel id such as -1001234567890, or @name.
# The bot must be an administrator of that channel. Unset means no announcement.
TELEGRAM_ANNOUNCE_CHAT_ID=@replace-with-the-shop-channel
# Used for the "Mua ngay" deep link on an announcement. Without it the post
# still goes out, just without the button.
TELEGRAM_BOT_USERNAME=hub_william_bot
# Shop receiving account shown on the VND checkout panel. All three must be set
# together, or the VND button tells the buyer that transfers are not configured
# instead of showing invented details. They are displayed only — the QR itself
# is the fixed image in assets/qr-bank.png.
TELEGRAM_PAYMENT_BANK_NAME=Techcombank
TELEGRAM_PAYMENT_ACCOUNT_HOLDER=replace-with-the-account-holder
TELEGRAM_PAYMENT_ACCOUNT_NUMBER=replace-with-the-account-number
# Prefix of the transfer note a buyer sends, followed by the order reference.
# Uppercase ASCII letters and spaces only, because banks reject accents, and
# SePay matches the reference out of this note.
# TELEGRAM_PAYMENT_MEMO_PREFIX=CAM TIEN DI CHILL THOI
# Optional USDT checkout. Address and rate must be set together; the network
# defaults to TRC20. The rate is how many đồng one USDT is charged at. USDT is
# reconciled by hand — only the bank transfer is settled by SePay.
# TELEGRAM_PAYMENT_USDT_ADDRESS=replace-with-the-wallet-address
# TELEGRAM_PAYMENT_USDT_NETWORK=TRC20
# TELEGRAM_PAYMENT_USDT_VND_RATE=26000
